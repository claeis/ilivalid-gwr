    TOPIC TopicA = 
  
        CLASS Bodenbedeckung =
        	EGID: IliValidGwr_V1_0.GWR_EGID;
        	EDID: IliValidGwr_V1_0.GWR_EDID;
        	strname : TEXT;

            MANDATORY CONSTRAINT GWRC02a: 
                 IliValidGwr_V1_0.eingangStrassenbezeichnungGWR(EGID,EDID)==strname;

        END Bodenbedeckung;
        
    END TopicA;

END EingangStrassenbezeichnungTest.
