INTERLIS 2.4;

MODEL EgidSetCompareGstatTest (de) 
AT "mailto:ce@eisenhutinformatik.ch" 
VERSION "2025-09-24" =
IMPORTS IliValidGwr_V1_0;

    TOPIC TopicA = 
  
        CLASS Bodenbedeckung =
        	MunicipalityId: IliValidGwr_V1_0.MunicipalityId;
        	EGID: IliValidGwr_V1_0.GWR_EGID;
        	gstat: LIST OF 1..9999;
            SET CONSTRAINT GWRC05: 
                 IliValidGwr_V1_0.egidSetCompareGstatGWR(ALL,>>EGID,MunicipalityId,gstat);

        END Bodenbedeckung;
        
    END TopicA;

END EgidSetCompareGstatTest.
